---
const features = [
  ["Consented signals", "Ingest audience interactions with source, purpose, consent, and retention context attached to every event."],
  ["Identity-aware dedupe", "Normalize channel identities and idempotency keys so one audience moment does not become five competing actions."],
  ["Moment scoring", "Rank recency, relevance, affinity, campaign fit, and fatigue before routing an opportunity."],
  ["Campaign routing", "Deliver approved moments to the right workflow, channel, or partner without giving event intake delivery authority."],
  ["Observable outcomes", "Track accepted, rejected, delivered, engaged, expired, and suppressed states as first-class transitions."],
  ["Privacy boundaries", "Keep consent, suppression, deletion, and retention policy explicit rather than buried in downstream campaign code."],
];
const samples = [
  { id:"typescript", label:"TypeScript API preview", file:"moment.ts", code:`const moment = await fetch(baseUrl + "/v1/moments", {
  method: "POST",
  headers: {
    authorization: "Bearer " + accessToken,
    "content-type": "application/json",
    "idempotency-key": event.id,
  },
  body: JSON.stringify({
    source: "livestream",
    audienceRef: "aud_01J...",
    kind: "high-intent-comment",
    occurredAt: event.occurredAt,
    consentRef: "consent_01J...",
    attributes: { topic: "launch", sentiment: "positive" },
  }),
}).then((response) => response.json());

console.log(moment.id, moment.state, moment.score);`, note:"Illustrative API preview. A final public interface package must freeze names and payloads before production use." },
  { id:"curl", label:"curl route preview", file:"route.sh", code:`curl --fail-with-body \
  -X POST "$BASE_URL/v1/moments/$MOMENT_ID/route" \
  -H "authorization: Bearer $ACCESS_TOKEN" \
  -H "content-type: application/json" \
  --data '{
    "campaignId":"campaign_01J...",
    "channel":"review-queue",
    "expiresInSeconds":900
  }'

# Routing creates a reviewable delivery intent; it does not
# silently contact or message an audience member.`, note:"The preview keeps opportunity routing separate from human-approved outreach or partner delivery." },
  { id:"event", label:"Audience event JSON", file:"audience-event.json", code:`{
  "eventId": "evt_01J...",
  "source": "livestream",
  "audienceRef": "aud_01J...",
  "kind": "high-intent-comment",
  "occurredAt": "2026-08-05T19:42:11Z",
  "consent": {
    "reference": "consent_01J...",
    "purposes": ["analytics", "campaign-review"]
  },
  "attributes": {
    "topic": "launch",
    "sentiment": "positive"
  }
}`, note:"Source, consent, and purpose travel with the signal so downstream routing cannot erase provenance." },
  { id:"webhook", label:"Webhook verification", file:"webhook.ts", code:`const rawBody = await request.text();
const signature = request.headers.get("fanwaave-signature");

verifyWebhook({
  rawBody,
  signature,
  secret: webhookSecret,
  maxAgeSeconds: 300,
});

const event = JSON.parse(rawBody);
await outcomes.record(event.deliveryId, event.state);`, note:"Representative verification boundary: sign raw bytes, reject stale deliveries, then process idempotently." },
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Consent-aware audience signals, campaign moments, and observable routing outcomes."><meta name="theme-color" content="#15100a"><title>Fanwaave — catch the audience moment</title></head><body>
<header><a class="brand" href="/"><b>FW</b><span>Fanwaave</span></a><nav><a href="#platform">Platform</a><a href="#clients">API</a><a href="https://github.com/fanwaave">GitHub ↗</a></nav></header><main>
<section class="hero"><div><p class="eyebrow">Audience signals · Campaign moments</p><h1>Catch the moment before the <em>wave moves on.</em></h1><p class="lede">Fanwaave turns consented audience activity into deduplicated, scored, time-bounded campaign opportunities—with reviewable routing and observable outcomes.</p><div class="actions"><a class="primary" href="https://github.com/fanwaave">Explore the project ↗</a><a href="#clients">See the API preview</a></div><ul><li>Consent-aware intake</li><li>Moment scoring</li><li>Observable routing</li></ul></div>
<div class="visual"><span class="grid"></span><div class="wave w1"></div><div class="wave w2"></div><div class="core"><small>LIVE MOMENT</small><strong>score 0.92</strong><i>expires in 08:41</i></div><div class="chip c1">SIGNALS<b>1,284/min</b></div><div class="chip c2">DEDUPE<b>99.8%</b></div><div class="chip c3">CONSENT<b>verified</b></div><div class="chip c4">ROUTING<b>review queue</b></div></div></section>
<section class="metrics"><div><b>1</b><span>audience moment</span></div><div><b>5</b><span>explicit outcomes</span></div><div><b>0</b><span>silent outreach</span></div><div><b>100%</b><span>provenance attached</span></div></section>
<section id="platform" class="platform"><p class="eyebrow">Signals with context</p><h2>Relevance without losing consent, provenance, or control.</h2><p class="intro">Intake, identity normalization, scoring, suppression, review, delivery, and outcome capture remain separate. That keeps a high-scoring event from becoming an automatic message merely because it arrived quickly.</p><div class="features">{features.map(([title,body],index)=><article><small>{String(index+1).padStart(2,"0")}</small><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section id="clients" class="sdk" data-sdk><div><p class="eyebrow">API preview</p><h2>Design integrations around moments, consent, and idempotent outcomes.</h2><p class="intro">Fanwaave does not yet publish `fanwaave-clients`. These examples describe the intended boundaries and are deliberately labeled as previews until a public interface package freezes the contract.</p><a class="source-link" href="https://github.com/fanwaave">Follow the implementation ↗</a></div><div class="workbench"><div class="toolbar"><label><span>Example</span><select aria-label="Select client language" data-language>{samples.map((sample,index)=><option value={sample.id} selected={index===0}>{sample.label}</option>)}</select></label><code data-file>{samples[0]?.file ?? "moment.ts"}</code><button type="button" data-copy>Copy</button></div>{samples.map((sample,index)=><article data-sample={sample.id} data-name={sample.file} hidden={index!==0}><pre tabindex="0"><code>{sample.code}</code></pre><p>{sample.note}</p></article>)}</div></section>
<section class="closing"><p class="eyebrow">Timing matters. Consent matters more.</p><h2>Turn audience energy into reviewable opportunity.</h2><a href="https://github.com/fanwaave">Open the organization ↗</a></section></main><footer><span>© 2026 Fanwaave</span><a href="https://github.com/fanwaave">Source</a></footer>
<script is:inline>document.querySelectorAll('[data-sdk]').forEach((root)=>{const select=root.querySelector('[data-language]'),file=root.querySelector('[data-file]'),copy=root.querySelector('[data-copy]'),panels=[...root.querySelectorAll('[data-sample]')];const show=(id)=>panels.forEach((panel)=>{const active=panel.dataset.sample===id;panel.hidden=!active;if(active)file.textContent=panel.dataset.name||''});select?.addEventListener('change',(event)=>show(event.target.value));copy?.addEventListener('click',async()=>{const active=panels.find((panel)=>!panel.hidden),text=active?.querySelector('code')?.textContent||'';try{await navigator.clipboard.writeText(text);copy.textContent='Copied'}catch{active?.querySelector('pre')?.focus();copy.textContent='Select code'}setTimeout(()=>copy.textContent='Copy',1200)})});</script>
<style>:root{--accent:#ea580c;--hot:#f59e0b;--ink:#15100a;--muted:#74685d;--paper:#fffaf4}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:linear-gradient(180deg,#fff7ed,var(--paper) 36rem);color:var(--ink);font:16px/1.6 Inter,ui-sans-serif,system-ui,sans-serif}a{color:inherit}header,main,footer{width:min(1180px,calc(100% - 2rem));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 0}.brand{display:flex;gap:.6rem;align-items:center;font-weight:900;text-decoration:none}.brand b{display:grid;width:2.35rem;aspect-ratio:1;place-items:center;border-radius:.75rem;background:var(--ink);color:white;font-size:.7rem}nav{display:flex;gap:1.2rem;font-size:.85rem;font-weight:800}nav a{text-decoration:none}.hero{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(2rem,7vw,7rem);align-items:center;min-height:720px;padding:5rem 0}.eyebrow{margin:0;color:var(--accent);font:800 .7rem/1 ui-monospace,monospace;letter-spacing:.17em;text-transform:uppercase}h1{max-width:12ch;margin:.8rem 0 1.25rem;font-size:clamp(3.5rem,8vw,7rem);line-height:.86;letter-spacing:-.075em}h1 em{background:linear-gradient(120deg,var(--accent),var(--hot));background-clip:text;color:transparent;font-style:normal}.lede,.intro{max-width:48rem;color:var(--muted);font-size:1.08rem}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:2rem 0}.actions a,.closing a{padding:.75rem 1rem;border:1px solid #4314071b;border-radius:.75rem;font-weight:850;text-decoration:none}.primary{background:var(--ink);color:white}.hero ul{display:flex;gap:1rem;flex-wrap:wrap;margin:0;padding:0;color:var(--muted);font-size:.8rem;list-style:none}.hero li:before{content:'◆';margin-right:.4rem;color:var(--accent)}.visual{position:relative;min-height:32rem;overflow:hidden;border-radius:2rem;background:radial-gradient(circle at 50% 48%,#f9731648,transparent 40%),linear-gradient(145deg,#160d07,#3c1c0e);box-shadow:0 35px 90px #7c2d1240}.grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff0c 1px,transparent 1px),linear-gradient(90deg,#ffffff0c 1px,transparent 1px);background-size:2.4rem 2.4rem}.wave{position:absolute;left:-12%;width:125%;height:12rem;border:2px solid #fb923c80;border-radius:50%}.w1{top:27%;transform:rotate(-8deg)}.w2{top:41%;transform:rotate(9deg)}.core,.chip{position:absolute;z-index:2;display:grid;padding:.9rem;border:1px solid #ffffff25;border-radius:1rem;background:#2d1309df;color:#fdba74;backdrop-filter:blur(12px);font:700 .64rem/1.5 ui-monospace,monospace}.core{top:50%;left:50%;width:14rem;padding:1.2rem;transform:translate(-50%,-50%)}.core strong,.chip b{color:white}.core strong{font-size:1.28rem}.core i{font-style:normal}.c1{top:8%;left:7%}.c2{top:8%;right:7%}.c3{bottom:9%;left:7%}.c4{right:7%;bottom:9%}.metrics{display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;border:1px solid #7c2d1218;border-radius:1.15rem;background:#ffffffc9}.metrics div{display:grid;padding:1.2rem}.metrics div+div{border-left:1px solid #7c2d1218}.metrics b{font-size:1.3rem}.metrics span{color:var(--muted);font-size:.76rem}.platform{padding:8rem 0}.platform h2,.sdk h2,.closing h2{max-width:15ch;margin:.55rem 0 1rem;font-size:clamp(2.6rem,6vw,5rem);line-height:.94;letter-spacing:-.06em}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.features article{min-height:14rem;padding:1.3rem;border:1px solid #7c2d1214;border-radius:1.1rem;background:#ffffffc5}.features small{color:var(--accent);font:800 .68rem/1 ui-monospace,monospace}.features h3{margin:2.1rem 0 .55rem}.features p{color:var(--muted)}.sdk{display:grid;grid-template-columns:minmax(0,.78fr) minmax(31rem,1.22fr);gap:clamp(2rem,7vw,6rem);align-items:center;margin:3rem 0 9rem}.source-link{display:inline-block;margin-top:1rem;color:var(--accent);font-weight:850;text-decoration:none}.workbench{overflow:hidden;border:1px solid #ffffff24;border-radius:1.25rem;background:#160d07;color:#ffedd5;box-shadow:0 32px 90px #7c2d1240}.toolbar{display:flex;gap:.8rem;align-items:end;padding:.85rem 1rem;border-bottom:1px solid #ffffff18;background:#2c1409}.toolbar label{display:grid;gap:.25rem}.toolbar label span{color:#fdba74;font:700 .6rem/1 ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase}.toolbar select,.toolbar button{border:1px solid #ffffff28;border-radius:.58rem;background:#46200d;color:white;padding:.5rem .65rem;font:inherit}.toolbar button{margin-left:auto;cursor:pointer}.toolbar>code{align-self:center;color:#fdba74;font-size:.75rem}.workbench pre{overflow:auto;min-height:23rem;max-height:31rem;margin:0;padding:1.2rem;font:500 .82rem/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre}.workbench article>p{margin:0;padding:.8rem 1.2rem 1rem;border-top:1px solid #ffffff15;color:#fdba74;font-size:.78rem}.closing{margin-bottom:2rem;padding:clamp(2rem,7vw,6rem);border-radius:1.8rem;background:linear-gradient(125deg,var(--accent),var(--hot));color:white}.closing .eyebrow{color:#ffffffc7}.closing a{display:inline-block;margin-top:1rem;background:white;color:var(--ink)}footer{display:flex;gap:1rem;padding:1.5rem 0 3rem;color:var(--muted);font-size:.78rem}footer span{margin-right:auto}footer a{text-decoration:none}@media(max-width:900px){.hero,.sdk{grid-template-columns:1fr}.features{grid-template-columns:1fr 1fr}}@media(max-width:650px){nav a:not(:last-child){display:none}.visual{min-height:26rem}.metrics{grid-template-columns:1fr 1fr}.features{grid-template-columns:1fr}.toolbar{align-items:stretch;flex-wrap:wrap}.toolbar>code{width:100%;order:3}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style></body></html>
